{
  "name": "everstake-kb",
  "version": "0.1.0",
  "description": "Knowledge assistant over a public corpus about Everstake: crawl, dedup, rank by recency/authority, answer with sources and dates, honest 'I don't know'.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "crawl": "tsx src/cli.ts crawl",
    "dedup": "tsx src/cli.ts dedup",
    "index": "tsx src/cli.ts index",
    "facts": "tsx src/cli.ts facts",
    "ask": "tsx src/cli.ts ask",
    "eval": "tsx src/cli.ts eval",
    "eval:adversarial": "tsx src/cli.ts adversarial",
    "cost": "tsx src/cli.ts cost",
    "refresh": "tsx src/cli.ts refresh",
    "schedule": "tsx src/cli.ts schedule",
    "stats": "tsx src/cli.ts stats",
    "pipeline": "tsx src/cli.ts pipeline",
    "serve": "tsx src/server/main.ts",
    "mcp": "tsx src/server/mcp.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/main.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "hono": "^4.13.7",
    "yaml": "^2.9.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
