# --- LLM provider -----------------------------------------------------------
# "anthropic" uses the official SDK (recommended). "openrouter" is a drop-in
# fallback that reaches the same Claude models through OpenRouter's OpenAI-style API.
LLM_PROVIDER=anthropic          # anthropic | openrouter | gemini
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# "gemini" maps the Claude model ids in config/kb.yaml onto these two models (cheapest path for a full run)
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-3.8-flash
GEMINI_CHEAP_MODEL=gemini-2.5-flash-lite

# --- Embeddings -------------------------------------------------------------
# "openai" (text-embedding-3-small), "voyage" (voyage-3-lite) or "none" (BM25 only)
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Storage / server ------------------------------------------------------
DATA_DIR=./data
PORT=4320
